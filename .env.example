# --- apps/api ---
DATABASE_URL="postgresql://alturia:alturia@localhost:5432/alturia"
JWT_SECRET="change-me-in-every-environment"
JWT_EXPIRES_IN="7d"
PORT=3000
# No DASHBOARD_ORIGIN/WIDGET_ORIGIN — CORS is open on purpose (see main.ts);
# an embeddable widget has to work on any origin a customer pastes it into.
# Real access control is JwtAuthGuard on the admin/dashboard routes, not CORS.

# Every variable is validated at boot (apps/api/src/config/env.schema.ts):
# a missing or misspelled value stops the API with a clear message.

# Values: "ollama" | "openrouter". OPENROUTER_* become required with openrouter.
LLM_CHAT_PROVIDER="ollama"
# Optional — nothing calls embeddings yet (knowledge is context stuffing).
# Values: "ollama" | "openai". OPENAI_API_KEY becomes required with openai.
EMBEDDING_PROVIDER="ollama"

# Local dev (Ollama running natively on the host, not in Docker)
OLLAMA_BASE_URL="http://localhost:11434"
# 7b keeps VRAM requirements modest across dev machines; bump to a 14b
# instruct variant (ollama pull qwen2.5:14b-instruct-q4_K_M) if you want
# better quality and have the GPU memory for it.
OLLAMA_CHAT_MODEL="qwen2.5:7b"
OLLAMA_EMBED_MODEL="nomic-embed-text"
# nomic-embed-text produces 768-dim vectors; the KnowledgeChunk.embedding column
# is fixed at vector(768) in the Prisma schema — if you swap embedding models,
# match the dimension or update the schema + migration.

# Cloud chat provider (production) — OpenRouter's free tier is enough for a
# demo. Free models get deprecated/renamed without notice (this replaced an
# earlier one that stopped working) — check openrouter.ai/models?max_price=0
# for a current one before relying on this long term.
OPENROUTER_API_KEY=""
OPENROUTER_CHAT_MODEL="nvidia/nemotron-3-nano-30b-a3b:free"

# Cloud embedding provider (production) — required if EMBEDDING_PROVIDER=openai.
# text-embedding-3-small is not free, but it's cheap (~$0.02 per 1M tokens).
OPENAI_API_KEY=""
OPENAI_EMBED_MODEL="text-embedding-3-small"

# Password for the admin created by `pnpm db:seed` (falls back to a dev default).
SEED_ADMIN_PASSWORD=""

# Optional: point the e2e suite at an existing Postgres instead of starting a
# throwaway Testcontainers one (CI does this). Its data is NOT wiped.
# E2E_DATABASE_URL="postgresql://alturia:alturia@localhost:5432/alturia_e2e"

# --- apps/dashboard ---
VITE_API_BASE_URL="http://localhost:3000"

# --- apps/widget ---
VITE_WIDGET_API_BASE_URL="http://localhost:3000"
