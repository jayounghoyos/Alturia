# --- apps/api ---
DATABASE_URL="postgresql://alturia:alturia@localhost:5432/alturia"
JWT_SECRET="change-me-in-every-environment"
JWT_EXPIRES_IN="7d"
PORT=3000
DASHBOARD_ORIGIN="http://localhost:5173"
# In production WIDGET_ORIGIN is https://asisaltura.co — the bot is only embedded there.
WIDGET_ORIGIN="http://localhost:5174"

# LLM_CHAT_PROVIDER and EMBEDDING_PROVIDER are independent switches on purpose:
# chat and embeddings can run on different models, so they need to be
# selectable separately.
# Values: "ollama" | "openrouter"
LLM_CHAT_PROVIDER="ollama"
# Values: "ollama" | "openai"
EMBEDDING_PROVIDER="ollama"

# Local dev (Ollama running natively on the host, not in Docker)
OLLAMA_BASE_URL="http://localhost:11434"
# 7b keeps VRAM requirements modest across dev machines; bump to a 14b
# instruct variant (ollama pull qwen2.5:14b-instruct-q4_K_M) if you want
# better quality and have the GPU memory for it.
OLLAMA_CHAT_MODEL="qwen2.5:7b"
OLLAMA_EMBED_MODEL="nomic-embed-text"
# nomic-embed-text produces 768-dim vectors; the KnowledgeChunk.embedding column
# is fixed at vector(768) in the Prisma schema — if you swap embedding models,
# match the dimension or update the schema + migration.

# Cloud chat provider (production) — OpenRouter's free tier (qwen3.6-plus:free)
# is enough for a demo: 20 req/min, 200 req/day. Free models can change or get
# pulled without notice — check openrouter.ai/models before relying on it long
# term, and swap to a paid Qwen route (e.g. qwen/qwen3.6-plus) if you outgrow it.
OPENROUTER_API_KEY=""
OPENROUTER_CHAT_MODEL="qwen/qwen3.6-plus:free"

# Cloud embedding provider (production) — required if EMBEDDING_PROVIDER=openai.
# text-embedding-3-small is not free, but it's cheap (~$0.02 per 1M tokens).
OPENAI_API_KEY=""
OPENAI_EMBED_MODEL="text-embedding-3-small"

# --- apps/dashboard ---
VITE_API_BASE_URL="http://localhost:3000"

# --- apps/widget ---
VITE_WIDGET_API_BASE_URL="http://localhost:3000"
