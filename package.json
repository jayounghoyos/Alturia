{
  "name": "alturia",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "pnpm --filter shared run build",
    "dev": "pnpm db:up && pnpm db:migrate && pnpm db:seed && pnpm --parallel --filter \"./apps/*\" --filter shared run dev",
    "dev:api": "pnpm --filter api run dev",
    "dev:dashboard": "pnpm --filter dashboard dev",
    "dev:widget": "pnpm --filter widget dev",
    "db:up": "docker compose up -d --wait postgres",
    "db:migrate": "pnpm --filter api exec prisma migrate deploy",
    "db:migrate:new": "pnpm --filter api exec prisma migrate dev --create-only",
    "db:seed": "pnpm --filter api run seed",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "format": "prettier --write apps packages .github \"*.{json,yaml,yml}\"",
    "format:check": "prettier --check apps packages .github \"*.{json,yaml,yml}\""
  },
  "packageManager": "pnpm@10.27.0",
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
