// AlturiaBot — one chatbot platform, many clients. Each client is a `Bot`:
// its branding, persona, knowledge base, conversations, escalations and admins
// are scoped to it.
//
// Worker/Certificate/Course/CourseSession/Appointment are Asis Altura's own
// domain (the first client) and stay global: only bots with those features
// enabled read them, and only the platform admin can enable them. Asis Altura
// doesn't share their real database, so these are seeded with simulated data
// faithful to the domain (prisma/seed.ts) — the shape follows Colombian
// working-at-heights regulation (Res. 4272/2021: the course certificate and
// the occupational medical exam are two independent expirations).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// --- Bots (one per client) -------------------------------------------------

enum BotFeature {
  CERTIFICATES
  QR
  APPOINTMENTS
  FAQ
  HUMAN_HANDOFF
}

model Bot {
  /// "bot_default" is Asis Altura: rows written before bots existed belong to it.
  id                 String       @id @default(cuid())
  slug               String       @unique
  /// Identifier in the client's embed (<script data-bot="...">). Public, not a secret.
  publicKey          String       @unique
  name               String
  greeting           String
  /// { primaryColor, position, avatarPreset } — see BotThemeSchema in packages/shared.
  theme              Json
  /// Base of the LLM system prompt: who the bot is and how it behaves.
  persona            String
  escalationKeywords String[]
  escalationReply    String
  faqQuickQuestions  String[]
  features           BotFeature[]
  /// Origins expected to embed this bot. A hint against casual misuse, not
  /// security: non-browser clients can send any Origin.
  allowedOrigins     String[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  avatar        BotAsset?
  admins        AdminUser[]
  conversations Conversation[]
  knowledge     KnowledgeSource[]
}

/// Uploaded avatar, kept apart from Bot so resolving a bot per request never
/// loads the image. Stored in Postgres because the API's host has an
/// ephemeral filesystem.
model BotAsset {
  botId     String   @id
  bot       Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  bytes     Bytes
  mime      String
  /// Bumped on every upload; part of the public URL so caches never go stale.
  version   Int      @default(1)
  updatedAt DateTime @updatedAt
}

// --- Admin staff ---------------------------------------------------------------

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  botId String @default("bot_default")
  bot   Bot    @relation(fields: [botId], references: [id])

  @@index([botId])
}

// --- Domain: workers and certificates ---------------------------------------

model Worker {
  id         String   @id @default(cuid())
  nationalId String   @unique
  name       String
  phone      String?
  createdAt  DateTime @default(now())

  certificates Certificate[]
  appointments Appointment[]
}

enum ExpirationType {
  COURSE
  MEDICAL_EXAM
}

enum CertificateStatus {
  VALID
  EXPIRED
}

model Certificate {
  id             String            @id @default(cuid())
  /// Opaque value encoded in the certificate QR. Never contains personal data.
  publicToken    String            @unique @default(cuid())
  expirationType ExpirationType
  issuedAt       DateTime
  expiresAt      DateTime
  status         CertificateStatus
  createdAt      DateTime          @default(now())

  workerId String
  worker   Worker @relation(fields: [workerId], references: [id])

  courseId String
  course   Course @relation(fields: [courseId], references: [id])

  @@index([workerId])
}

enum CourseType {
  ADVANCED
  RETRAINING
}

model Course {
  id   String     @id @default(cuid())
  name String
  type CourseType

  certificates Certificate[]
  sessions     CourseSession[]
}

model CourseSession {
  id             String   @id @default(cuid())
  date           DateTime
  time           String
  availableSlots Int
  location       String

  courseId String
  course   Course @relation(fields: [courseId], references: [id])

  appointments Appointment[]

  @@index([courseId])
}

enum AppointmentStatus {
  CONFIRMED
  CANCELLED
}

model Appointment {
  id               String            @id @default(cuid())
  confirmationCode String            @unique
  status           AppointmentStatus @default(CONFIRMED)
  createdAt        DateTime          @default(now())

  workerId String
  worker   Worker @relation(fields: [workerId], references: [id])

  courseSessionId String
  courseSession   CourseSession @relation(fields: [courseSessionId], references: [id])
}

// --- Knowledge / RAG for FAQ --------------------------------------------------

enum SourceType {
  FILE
  TEXT
}

enum IngestStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

model KnowledgeSource {
  id        String       @id @default(cuid())
  type      SourceType
  title     String
  content   String?
  status    IngestStatus @default(PENDING)
  createdAt DateTime     @default(now())

  botId String @default("bot_default")
  bot   Bot    @relation(fields: [botId], references: [id])

  chunks KnowledgeChunk[]

  @@index([botId])
}

model KnowledgeChunk {
  id         String   @id @default(cuid())
  content    String
  chunkIndex Int
  createdAt  DateTime @default(now())

  sourceId String
  source   KnowledgeSource @relation(fields: [sourceId], references: [id])

  /// See apps/api/prisma/README.md — Prisma has no native vector type, so the
  /// ivfflat index is added by hand to the migration. Dimension fixed at 768
  /// (nomic-embed-text) — switching embedding providers means re-seeding.
  embedding Unsupported("vector(768)")?
}

// --- Conversations and escalation --------------------------------------------

enum ConvStatus {
  OPEN
  ESCALATED
  CLOSED
}

model Conversation {
  id            String     @id @default(cuid())
  /// Anonymous visitor id generated by the widget (a v4 UUID, one per bot per
  /// browser). Globally unique; reads also check botId so one bot's widget
  /// can never reach another bot's conversation.
  sessionId     String     @unique
  status        ConvStatus @default(OPEN)
  /// In-flight appointment-booking flow progress: { step, collectedData }.
  flowState     Json?
  startedAt     DateTime   @default(now())
  lastMessageAt DateTime   @updatedAt

  botId String @default("bot_default")
  bot   Bot    @relation(fields: [botId], references: [id])

  messages    Message[]
  escalations Escalation[]

  @@index([botId, status])
}

enum MsgRole {
  USER
  BOT
  ADMIN
  SYSTEM
}

model Message {
  id        String   @id @default(cuid())
  role      MsgRole
  content   String
  /// { retrievedChunkIds, confidenceScore } — debugging context, never shown raw to end users.
  metadata  Json?
  createdAt DateTime @default(now())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
}

enum EscStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model Escalation {
  id          String    @id @default(cuid())
  reason      String
  /// { name, phone, email, consentGiven, consentTimestamp } — Colombian Law 1581 of 2012.
  contactInfo Json?
  status      EscStatus @default(OPEN)
  createdAt   DateTime  @default(now())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  @@index([status])
}
