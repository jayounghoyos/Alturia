// Alturia — Asis Altura chatbot (single client, no multi-tenancy).
// The client doesn't share their real database, so Worker/Certificate/Course/
// CourseSession are seeded with simulated data faithful to the domain
// (prisma/seed.ts) — the model shape follows Colombian working-at-heights
// regulation (Res. 4272/2021: the course certificate and the occupational
// medical exam are two independent expirations, see `ExpirationType`).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// --- Admin staff (simple login, no multi-tenancy) ---------------------------

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

// --- Domain: workers and certificates ---------------------------------------

model Worker {
  id          String   @id @default(cuid())
  nationalId  String   @unique
  name        String
  phone       String?
  createdAt   DateTime @default(now())

  certificates Certificate[]
  appointments Appointment[]
}

enum ExpirationType {
  COURSE
  MEDICAL_EXAM
}

enum CertificateStatus {
  VALID
  EXPIRED
}

model Certificate {
  id             String            @id @default(cuid())
  expirationType ExpirationType
  issuedAt       DateTime
  expiresAt      DateTime
  status         CertificateStatus
  createdAt      DateTime          @default(now())

  workerId String
  worker   Worker @relation(fields: [workerId], references: [id])

  courseId String
  course   Course @relation(fields: [courseId], references: [id])

  @@index([workerId])
}

enum CourseType {
  ADVANCED
  RETRAINING
}

model Course {
  id   String     @id @default(cuid())
  name String
  type CourseType

  certificates Certificate[]
  sessions     CourseSession[]
}

model CourseSession {
  id             String   @id @default(cuid())
  date           DateTime
  time           String
  availableSlots Int
  location       String

  courseId String
  course   Course @relation(fields: [courseId], references: [id])

  appointments Appointment[]

  @@index([courseId])
}

enum AppointmentStatus {
  CONFIRMED
  CANCELLED
}

model Appointment {
  id               String            @id @default(cuid())
  confirmationCode String            @unique
  status           AppointmentStatus @default(CONFIRMED)
  createdAt        DateTime          @default(now())

  workerId String
  worker   Worker @relation(fields: [workerId], references: [id])

  courseSessionId String
  courseSession   CourseSession @relation(fields: [courseSessionId], references: [id])
}

// --- Knowledge / RAG for FAQ --------------------------------------------------

enum SourceType {
  FILE
  TEXT
}

enum IngestStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

model KnowledgeSource {
  id        String       @id @default(cuid())
  type      SourceType
  title     String
  content   String?
  status    IngestStatus @default(PENDING)
  createdAt DateTime     @default(now())

  chunks KnowledgeChunk[]
}

model KnowledgeChunk {
  id         String   @id @default(cuid())
  content    String
  chunkIndex Int
  createdAt  DateTime @default(now())

  sourceId String
  source   KnowledgeSource @relation(fields: [sourceId], references: [id])

  /// See apps/api/prisma/README.md — Prisma has no native vector type, so the
  /// ivfflat index is added by hand to the migration. Dimension fixed at 768
  /// (nomic-embed-text) — switching embedding providers means re-seeding.
  embedding Unsupported("vector(768)")?
}

// --- Conversations and escalation --------------------------------------------

enum ConvStatus {
  OPEN
  ESCALATED
  CLOSED
}

model Conversation {
  id            String     @id @default(cuid())
  /// Anonymous visitor id generated by the widget, persisted in localStorage.
  sessionId     String     @unique
  status        ConvStatus @default(OPEN)
  /// In-flight appointment-booking flow progress: { step, collectedData }.
  flowState     Json?
  startedAt     DateTime   @default(now())
  lastMessageAt DateTime   @updatedAt

  messages    Message[]
  escalations Escalation[]
}

enum MsgRole {
  USER
  BOT
  SYSTEM
}

model Message {
  id        String   @id @default(cuid())
  role      MsgRole
  content   String
  /// { retrievedChunkIds, confidenceScore } — debugging context, never shown raw to end users.
  metadata  Json?
  createdAt DateTime @default(now())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
}

enum EscStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model Escalation {
  id      String    @id @default(cuid())
  reason  String
  /// { name, phone, email, consentGiven, consentTimestamp } — Colombian Law 1581 of 2012.
  contactInfo Json?
  status  EscStatus @default(OPEN)
  createdAt DateTime @default(now())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  @@index([status])
}
