# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo

# Env
.env
.env.local
.env.*.local
!.env.example
# Symlink to the root .env — the Prisma CLI only looks in its cwd (apps/api),
# so this makes it see the same single source of truth. Not a secret itself.
!apps/api/.env

# Prisma
apps/api/prisma/migrations/**/migration.sql.bak

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editors / OS
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# Docker volumes (local dev data)
.docker-data/

# Test/coverage
coverage/
